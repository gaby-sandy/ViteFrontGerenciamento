{
    "extends": "./tsconfig.json",
    "compilerOptions": {
      "jsx": "react-jsx",
      "module": "esnext",
      "moduleResolution": "node",
      "types": ["jest", "jsdom"],
      "baseUrl": "./",
      "paths": {
        "@pages/*": ["src/pages/*"]
      }
    },
    "include": [
      "src",
      "jest.setup.ts",
      "src/**/*.spec.ts",
      "src/**/*.spec.tsx",
      "src/**/*.test.ts",
      "src/**/*.test.tsx"
    ]
  }
  